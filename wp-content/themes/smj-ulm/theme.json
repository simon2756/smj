{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "navy", "name": "SMJ-Blau (Logo)", "color": "#004E89" },
				{ "slug": "navy-dark", "name": "Nachtblau", "color": "#0B2E4F" },
				{ "slug": "sky", "name": "Himmelblau", "color": "#067FC1" },
				{ "slug": "sky-light", "name": "Hellblau", "color": "#E6EFF7" },
				{ "slug": "fire", "name": "Lagerfeuer", "color": "#B84E12" },
				{ "slug": "fire-light", "name": "Glut hell", "color": "#FDEBDD" },
				{ "slug": "ink", "name": "Text", "color": "#1B2533" },
				{ "slug": "muted", "name": "Text gedämpft", "color": "#5A6778" },
				{ "slug": "line", "name": "Linie", "color": "#E3E8EF" },
				{ "slug": "paper", "name": "Hintergrund", "color": "#F5F7FA" },
				{ "slug": "white", "name": "Weiß", "color": "#FFFFFF" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "1.5rem" },
				{ "slug": "40", "name": "L", "size": "clamp(1.75rem, 3vw, 2.5rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(2.5rem, 5vw, 4rem)" },
				{ "slug": "60", "name": "XXL", "size": "clamp(3rem, 7vw, 5.5rem)" }
			],
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Figtree",
					"fontFamily": "Figtree, system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{ "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "300 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/figtree-latin-wght-normal.woff2" ] },
						{ "fontFamily": "Figtree", "fontStyle": "italic", "fontWeight": "300 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/figtree-latin-wght-italic.woff2" ] }
					]
				},
				{
					"slug": "display",
					"name": "Bricolage Grotesque",
					"fontFamily": "'Bricolage Grotesque', Figtree, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Bricolage Grotesque", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/bricolage-grotesque-latin-wght-normal.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Klein", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Normal", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Groß", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "Sehr groß", "size": "1.75rem", "fluid": { "min": "1.4rem", "max": "1.75rem" } },
				{ "slug": "xx-large", "name": "Überschrift", "size": "2.5rem", "fluid": { "min": "1.9rem", "max": "2.5rem" } },
				{ "slug": "huge", "name": "Riesig", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" } }
			]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 1.5rem)",
				"right": "clamp(1rem, 4vw, 1.5rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"lineHeight": "1.12",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "letterSpacing": "-0.02em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "fontWeight": "700" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "700" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--navy)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--navy-dark)" } },
				":focus": { "color": { "text": "var(--wp--preset--color--navy-dark)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--navy)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.4rem", "right": "1.4rem" } },
				"typography": { "fontWeight": "700", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.2" },
				":hover": { "color": { "background": "var(--wp--preset--color--navy-dark)", "text": "var(--wp--preset--color--white)" } },
				":focus": { "color": { "background": "var(--wp--preset--color--navy-dark)", "text": "var(--wp--preset--color--white)" } }
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600" }
			},
			"core/post-excerpt": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--navy)", "width": "4px" } },
				"spacing": { "padding": { "left": "1.25rem" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Kopfbereich", "area": "header" },
		{ "name": "footer", "title": "Fußbereich", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Seite (breit)", "postTypes": [ "page" ] }
	]
}
